# Stripe (set real values in Vercel / .env.local — never commit secrets)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Public site URL used for Stripe success/cancel redirects
NEXT_PUBLIC_SITE_URL=https://vigitrust-website.vercel.app

# PostgreSQL (Vercel Postgres, Neon, Supabase, etc.)
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Admin token for /admin/renewal-codes (server-side only)
RENEWAL_ADMIN_TOKEN=choose-a-long-random-secret

# GitHub Pages static export only — leave unset on Vercel
# GITHUB_PAGES=true

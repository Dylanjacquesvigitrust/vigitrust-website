# Stripe (set real values in Vercel / .env.local — never commit secrets)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Catalog prices (GDPR Fundamentals — Stripe Tax applies at checkout)
STRIPE_PRODUCT_GDPR_FUNDAMENTALS=prod_V9LrFs3pewMJwz
STRIPE_PRICE_GDPR_FUNDAMENTALS=price_1U939NHa2NVkmBhF2xEAHTG4
COURSE_LINK_GDPR_FUNDAMENTALS=https://vigitrust-9067.reach360.com/share/course/6720ac09-68d9-404c-9204-e522ae19af3b

# Reach 360 (server-side only)
REACH360_API_KEY=
REACH360_API_BASE=https://api.reach360.com
REACH_COURSE_GDPR_FUNDAMENTALS=6720ac09-68d9-404c-9204-e522ae19af3b

# Resend (free tier) — course access emails after payment
# 1) Create account at https://resend.com
# 2) Add API key below
# 3) For production, verify your domain and set RESEND_FROM_EMAIL to that domain
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=VigiTrust <onboarding@resend.dev>

# Public site URL used for Stripe success/cancel redirects
NEXT_PUBLIC_SITE_URL=https://vigitrust-website.vercel.app

# PostgreSQL (Vercel Postgres, Neon, Supabase, etc.)
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Admin login for /login (server-side only; defaults exist if unset)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=systemadmin#23

# GitHub Pages static export only — leave unset on Vercel
# GITHUB_PAGES=true

# Stripe (set real values in Vercel / .env.local — never commit secrets)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Catalog prices (GDPR Fundamentals — Stripe Tax applies at checkout)
STRIPE_PRODUCT_GDPR_FUNDAMENTALS=prod_V9LrFs3pewMJwz
STRIPE_PRICE_GDPR_FUNDAMENTALS=price_1U939NHa2NVkmBhF2xEAHTG4

# Public site URL used for Stripe success/cancel redirects
NEXT_PUBLIC_SITE_URL=https://vigitrust-website.vercel.app

# PostgreSQL (Vercel Postgres, Neon, Supabase, etc.)
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Admin login for /login (server-side only; defaults exist if unset)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=systemadmin#23

# GitHub Pages static export only — leave unset on Vercel
# GITHUB_PAGES=true

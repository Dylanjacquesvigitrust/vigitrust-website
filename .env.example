# COURSE_LINK_PCI_INTRO=

# Resend — course access (qty 1) and bulk-order ops alerts (qty > 1)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=VigiTrust <onboarding@resend.dev>
OPS_ORDER_EMAIL=dylan.jacques@vigitrust.com

# Public site URL used for Stripe success/cancel redirects

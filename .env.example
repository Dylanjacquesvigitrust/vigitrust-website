NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Catalog prices (Stripe Tax applies at checkout)
STRIPE_PRODUCT_GDPR_FUNDAMENTALS=prod_V9LrFs3pewMJwz
STRIPE_PRICE_GDPR_FUNDAMENTALS=price_1U939NHa2NVkmBhF2xEAHTG4
STRIPE_PRODUCT_PCI_INTRO=prod_VBeS2GKAaC3eGm
STRIPE_PRICE_PCI_INTRO=price_1UBHA3Ha2NVkmBhFs8E9Eirq
STRIPE_PRODUCT_PCI_DSS_INTRO=prod_VBekLlG6IWMmNl
STRIPE_PRICE_PCI_DSS_INTRO=price_1UBHRBHa2NVkmBhFxH58dRi5

# Reach share link emailed for single-seat purchases
